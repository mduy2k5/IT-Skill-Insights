# Local PostgreSQL container used for job-platform OLTP data.
JOB_POSTGRES_HOST=127.0.0.1
JOB_POSTGRES_PORT=5434
JOB_POSTGRES_DB=it_job_platform
JOB_POSTGRES_USER=job_pipeline
JOB_POSTGRES_PASSWORD=replace_with_a_random_local_secret

# Read-only account used by the local Flask job catalog.
JOB_WEB_DB_USER=job_web_reader
JOB_WEB_DB_PASSWORD=replace_with_a_different_random_local_secret

# Local DuckDB OLAP server. Generate a unique random value before starting it.
JOB_OLAP_TOKEN=replace_with_a_random_local_secret
